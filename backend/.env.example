# ==============================================================================
# HOREMOW Backend Environment Configuration Template
# COPY TO .env FOR LOCAL DEVELOPMENT — NEVER COMMIT .env TO VERSION CONTROL
# ==============================================================================

# Django Core
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-to-a-secure-random-secret-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (PostgreSQL hosted on Supabase or local SQLite fallback)
# Production Format: postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/[DATABASE]
DATABASE_URL=POSTGRESQL_URL_PLACEHOLDER

# Admin Registration Authentication Code (Required to create SuperAdmin via UI)
SUPERADMIN_REGISTRATION_CODE=change-to-a-secure-secret-passcode-for-superadmin-setup

# Cloudinary (Media Library)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payment Integrations (Sandbox test keys by default)
PAYSTACK_SECRET_KEY=sk_test_placeholder
PAYSTACK_PUBLIC_KEY=pk_test_placeholder
PAYPAL_CLIENT_ID=client_id_placeholder
PAYPAL_CLIENT_SECRET=client_secret_placeholder
PAYPAL_WEBHOOK_ID=webhook_id_placeholder
PAYPAL_MODE=sandbox

# Email Dispatch (Resend API key + Fallback)
RESEND_API_KEY=re_placeholder
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Holiness Revival Movement Worldwide <donations@horemow.org>
# Supabase Storage Configuration (Publications & Books)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=publications
GEMINI_API_KEY=
